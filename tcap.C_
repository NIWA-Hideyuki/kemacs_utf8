/*
	tcap:	Unix V5, V7 and BS4.2 Terminfo video driver
		for MicroEMACS
*/

#define termdef 1			/* don't define "term" external */

#include "ecomm.h"
#include "estruct.h"
#include "edef.h"

#include <term.h>

/* setupterm/terminfo return OK (0) on success, ERR (-1) on failure.
   <term.h> on most systems only declares these via <curses.h>; define locally. */
#ifndef OK
# define OK 0
#endif

static Char *dummy = CSTR("");

#define MARGIN	8
#define SCRSIZ	48
#define NPAUSE	10			/* # times thru update to pause */
#define BEL	0x07
#define ESC	0x1B

extern int	ttopen();
extern Char	ttgetc();
extern int	ttputc();
extern int	ttflush();
extern int	ttclose();

extern int	tcapkopen();
extern int	tcapkclose();
extern int	tcapmove();
extern int	tcapeeol();
extern int	tcapeeop();
extern int	tcapbeep();
extern int	tcaprev();
extern int	tcapopen();
#if COLOR
extern int	tcapfcol();
extern int	tcapbcol();
#endif

extern int	putpad();
extern int	putnpad();

/*
 * Terminfo capability name to variable mapping.
 *
 * Termcap -> Terminfo capability name mapping:
 *   pc   -> (handled internally by setupterm/terminfo padding)
 *   up   -> cuu1  (cursor up one line)
 *   cm   -> cup   (cursor address / motion)
 *   ce   -> el    (clear to end of line)
 *   cl   -> clear (clear screen / home)
 *   so   -> smso  (start standout / reverse video)
 *   se   -> rmso  (end standout / reverse video)
 *   vs   -> cvvis (cursor very visible)
 *   ve   -> cnorm (cursor normal)
 *   ti   -> smcup (enter alternate screen / cursor_address mode)
 *   te   -> rmcup (exit alternate screen)
 *   ks   -> smkx  (start keypad mode / enable function keys)
 *   ke   -> rmkx  (end keypad mode / disable function keys)
 */
static char *UP, *CM, *CE, *CL, *SO, *SE, *VS, *VE, *TI, *TE, *KS, *KE;

struct tctab {
	char *cap;
	char **str;
};

static struct tctab tctab[] = {
	{"cuu1", &UP}, {"cup", &CM}, {"el", &CE}, {"clear", &CL},
	{"smso", &SO}, {"rmso", &SE}, {"cvvis", &VS}, {"cnorm", &VE},
	{"smcup", &TI}, {"rmcup", &TE}, {"smkx", &KS}, {"rmkx", &KE},
	{NULL, NULL}};

TERM term = {
	0,	/* these four values are set dynamically at open time */
	0,
	0,
	0,
	MARGIN,
	SCRSIZ,
	NPAUSE,
	tcapopen,
	ttclose,
        tcapkopen,
        tcapkclose,
	ttgetc,
	ttputc,
	ttflush,
	tcapmove,
	tcapeeol,
	tcapeeop,
	tcapbeep,
        tcaprev,
#if	COLOR
	tcapfcol,
	tcapbcol
#endif
};

/* output a raw string character by character via ttputc.
   Unlike putpad/tputs, this does NOT interpret $<delay> sequences. */
int out_str(char *s)
{
	if (s != NULL)
		while (*s)
			ttputc(*s++);
}

int tcapopen(void)
{
	char *tv_stype;
	char err_str[72];
	int errret;
	struct tctab *tp;
#if KANJI
	char *kj;
#endif

	if ((tv_stype = getenv("TERM")) == NULL) {
	    puts("Environment variable TERM not defined!");
	    exit(1);
	}

	/* initialize terminfo database for this terminal type */
	if (setupterm(tv_stype, fileno(stdout), &errret) != OK) {
	    (void)sprintf(err_str, "Unknown terminal type %s!", tv_stype);
	    puts(err_str);
	    exit(1);
	}

	get_screen_size(&term.t_nrow, &term.t_ncol);
	term.t_mrow = term.t_nrow;
	term.t_mcol = term.t_ncol;

	/* load terminal capability strings via terminfo tigetstr */
	for (tp = tctab; tp->cap; tp++) {
	    *tp->str = tigetstr(tp->cap);
	    /* tigetstr returns (char *)-1 for boolean/numeric caps */
	    if (*tp->str == (char *)-1)
	        *tp->str = NULL;
	}

	if (SO != NULL)
	    revexist = TRUE;

	if (CL == NULL || CM == NULL || UP == NULL) {
	    puts("Incomplete terminfo entry");
	    exit(1);
	}

	if (CE == NULL)		/* will we be able to use clear to EOL? */
	    eolexist = FALSE;

#if KANJI
# if defined(DEF_T_CODE)
	KS_INTERP(term.t_code) = KS_KANJI;
	KS_CODE(term.t_code) = DEF_T_CODE;
	KS_THRU(term.t_code) = DEF_T_THRU;
#  if defined(DEF_T_KI) && defined(DEF_T_RI)
	KS_KI(term.t_code) = DEF_T_KI;
	KS_RI(term.t_code) = DEF_T_RI;
#  endif
#  if KMSGS
	kterminal = TRUE;
#  endif
# else /* !DEF_T_CODE */
	KS_INTERP(term.t_code) = KS_BINARY;
#  if KMSGS
	kterminal = FALSE;
#  endif
# endif /* !DEF_T_CODE */
	KS_EOLINT(term.t_code) = KS_EOLKNOWN;
	KS_EOL(term.t_code) = KS_LF;
# if defined(KANJI_TERMCAP)
	/* get terminal's KANJI spec from terminfo.
	   "KJ" is a kemacs-specific capability; tigetstr searches for it
	   as a user-defined capability in the terminfo entry. */
	if ((kj = tigetstr(KANJI_TERMCAP)) != NULL && kj != (char *)-1) {
	  /* full spec can be retrieved */
	  KS_INTERP(term.t_code) = KS_KANJI;
#  if KMSGS
	  kterminal = TRUE;
#  endif
	  switch (*kj) {
	  case 'J': case 'j':
	    KS_CODE(term.t_code) = KS_JIS;
	    KS_THRU(term.t_code) = (*kj++ == 'J');
	    switch (*kj) {
	    case '@':
	      KS_KI(term.t_code) = KS_OLDJIS;
	      break;
	    case 'B':
	      KS_KI(term.t_code) = KS_NEWJIS;
	      break;
	    }
	    if (*kj++) {
	      switch (*kj) {
	      case 'B':
		KS_RI(term.t_code) = KS_ASCII;
		break;
	      case 'H':
		KS_RI(term.t_code) = KS_BOGUS;
		break;
	      case 'J':
		KS_RI(term.t_code) = KS_ROMAJI;
		break;
	      }
	    }
	    break;
	  case 'u': case 'U':
	    KS_CODE(term.t_code) = KS_UJIS;
	    KS_THRU(term.t_code) = 1;
	    break;
	  case 's': case 'S':
	    KS_CODE(term.t_code) = KS_SJIS;
	    KS_THRU(term.t_code) = 1;
	    break;
	  #if HANDLE_UTF
	  case 'w': case 'W':
	    KS_CODE(term.t_code) = KS_UTF8;
	    KS_THRU(term.t_code) = 1;
	    break;
	  #endif
	  }
	} else if (tigetflag(KANJI_TERMCAP) > 0) {
#  if KMSGS
	  kterminal = TRUE;
#  endif
	  KS_INTERP(term.t_code) = KS_KANJI;
	}
# endif /* KANJI_TERMCAP */
#endif /* KANJI */

	ttopen();
}

int tcapkopen(void)
{
#if KANJI
	kkopen();
	putpad(KS);
#endif
	putpad(TI);
	putpad(VS);
#if TERM_MODERN
	/* Enable modern terminal features:
	   1000: mouse tracking (button press/release)
	   1004: focus tracking
	   2004: bracketed paste mode */
	out_str("\033[?1000h\033[?1004h\033[?2004h");
#endif
}

int tcapkclose(void)
{
	putpad(VE);
	putpad(TE);
#if TERM_MODERN
	/* Disable modern terminal features */
	out_str("\033[?1000l\033[?1004l\033[?2004l");
#endif
#if KANJI
	putpad(KE);
	kkclose();
#endif
}

int tcapmove(int row, int col)
{
	if (CM != NULL)
		putpad(tparm(CM, (long)row, (long)col));
}

int tcapeeol(void)
{
	putpad(CE);
}

int tcapeeop(void)
{
	putpad(CL);
}

int tcaprev(int state)  /* change reverse video status	*/
{
	static int revstate = FALSE;
	if (state && !revstate) {
		if (SO != NULL)
			putpad(SO);
	}
	if (!state && revstate) {
		if (SE != NULL)
			putpad(SE);
	}
	revstate = state;
}

#if COLOR
# if COLOR_DEPTH == 1
/* 8-color SGR sequences: 3N foreground, 4N background */
int tcapfcol(int color)
{
	char buf[16];
	(void)sprintf(buf, "\033[%dm", 30 + (color & 7));
	out_str(buf);
}

int tcapbcol(int color)
{
	char buf[16];
	(void)sprintf(buf, "\033[%dm", 40 + (color & 7));
	out_str(buf);
}
# elif COLOR_DEPTH == 2
/* 256-color SGR: 38;5;N foreground, 48;5;N background */
int tcapfcol(int color)
{
	char buf[32];
	(void)sprintf(buf, "\033[38;5;%dm", color & 0xFF);
	out_str(buf);
}

int tcapbcol(int color)
{
	char buf[32];
	(void)sprintf(buf, "\033[48;5;%dm", color & 0xFF);
	out_str(buf);
}
# elif COLOR_DEPTH >= 3
/* Truecolor SGR: 38;2;r;g;b foreground, 48;2;r;g;b background.
   Maps the 8 basic color indices to standard VGA RGB values. */
static const struct { int r, g, b; } rgb_table[8] = {
    {   0,   0,   0 },  /* 0 = black   */
    { 205,   0,   0 },  /* 1 = red     */
    {   0, 205,   0 },  /* 2 = green   */
    { 205, 205,   0 },  /* 3 = yellow  */
    {   0,   0, 238 },  /* 4 = blue    */
    { 205,   0, 205 },  /* 5 = magenta */
    {   0, 205, 205 },  /* 6 = cyan    */
    { 229, 229, 229 }   /* 7 = white   */
};

int tcapfcol(int color)
{
	char buf[48];
	int c = color & 7;
	(void)sprintf(buf, "\033[38;2;%d;%d;%dm",
		      rgb_table[c].r, rgb_table[c].g, rgb_table[c].b);
	out_str(buf);
}

int tcapbcol(int color)
{
	char buf[48];
	int c = color & 7;
	(void)sprintf(buf, "\033[48;2;%d;%d;%dm",
		      rgb_table[c].r, rgb_table[c].g, rgb_table[c].b);
	out_str(buf);
}
# endif /* COLOR_DEPTH */
#endif /* COLOR */

int tcapbeep(void)
{
	ttputc(BEL);
}

int putpad(char *str)
{
	putnpad(str, 1);
}

int putnpad(char *str, int n)
{
	if (str != NULL)
		tputs(str, n, ttputc);
}

#if FLABEL
/*ARGSUSED*/
int fnclabel(int f, int n)  /* label a function key */
{
	/* on machines with no function keys...don't bother */
	return(TRUE);
}
#endif /*FLABEL*/

#include <signal.h>
#if !HAVE_TERMIOS
# include <termio.h>
#endif
#ifdef SIGWINCH
# include <sys/ioctl.h>
#endif

/* Get terminal size */
 /* modified by N.Nide; use LINES and COLUMNS if we have them (for uum) */
int get_screen_size(int *rowp, int *colp)
{
	int row, col, i;
	char *p;

#ifdef TIOCGWINSZ
	struct winsize wsz;

	if(ioctl(fileno(stdout), TIOCGWINSZ, &wsz) == -1)
		wsz.ws_row = wsz.ws_col = 0;
#else
#ifdef TIOCGSIZE
	struct ttysize tty;

	if (ioctl(fileno(stdout), TIOCGSIZE, &tty) == -1)
		tty.ts_lines = tty.ts_cols = 0;
#endif
#endif

#if USE_ENVSZ
	if(NULL != (p = getenv("LINES"))) {
		row = atoi(p) - 1;
	} else
#endif
#ifdef TIOCGWINSZ
	if(wsz.ws_row) {
		row = wsz.ws_row - 1;
	} else
#else
#ifdef TIOCGSIZE
	if(tty.ts_lines) {
		row = tty.ts_lines - 1;
	} else
#endif
#endif
	if((i = tigetnum("lines")) != -1) {
		row = i - 1;
	} else {
		puts("Terminfo entry incomplete (lines)");
		exit(1);
	}

#if USE_ENVSZ
	if(NULL != (p = getenv("COLUMNS"))) {
		col = atoi(p);
	} else
#endif
#ifdef TIOCGWINSZ
	if(wsz.ws_col) {
		col = wsz.ws_col;
	} else
#else
#ifdef TIOCGSIZE
	if(tty.ts_cols) {
		col = tty.ts_cols;
	} else
#endif
#endif
	if((i = tigetnum("cols")) != -1) {
		col = i;
	} else {
		puts("Terminfo entry incomplete (columns)");
		exit(1);
	}

	if (row > MAX_SCREEN_LINES) {
		puts("Number of lines on screen is larger than configration.");
		exit(1);
	}
	if (col > MAX_SCREEN_COLUMNS) {
		puts("Number of columns on screen is larger than configration.");
		exit(1);
	}
	*rowp = row;
	*colp = col;
}
