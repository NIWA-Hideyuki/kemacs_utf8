/*
 *	Spawn:	various OS access commands
 *		for MicroEMACS
 */

#include	"ecomm.h"
#include	"estruct.h"
#include	"edef.h"
#include	<stdlib.h>

#include	<signal.h>
#include	<pwd.h>
#include	<errno.h>
#include	<fcntl.h>
#include	<sys/stat.h>
#include	<sys/wait.h>
extern int vttidy();
static int System();

static char shell_esc_buf[NLINE * 5];	/* buffer for shell_command_escape_char */
char *shell_command_escape_char(const char *);

/*
 * Create a subjob with a copy of the command intrepreter in it. When the
 * command interpreter exits, mark the screen as garbage so that you do a full
 * repaint. Bound to "^X C". The message at the start in VMS puts out a newline.
 * Under some (unknown) condition, you don't get one free when DCL starts up.
 */
/*ARGSUSED*/
int spawncli(int f, int n)
{
	char *cp;


#if	RESTRICT
	/* don't allow this command if restricted */
	if (restflag)
		return(resterr());
#endif

	movecursor(term.t_nrow, 0);		/* Seek to last line.	*/
	TTflush();

	if((cp = getenv("SHELL")) == NULL || !*cp){
		struct passwd *ent = getpwuid(geteuid());

		cp = (ent == NULL ? "/bin/sh" : ent->pw_shell);
	}
	(void)System(cp, FALSE, NULL, NULL);

	sgarbf = TRUE;
	millisleep(TRUE, 1000);
	 /* originally sleep(2), but maybe 1sec is enough (Nide) */
	return(TRUE);
}

#ifdef SIGTSTP
int bktoshell(void)	/* suspend MicroEMACS and wait to wake up */
{
#if	RESTRICT
	/* don't allow this command if restricted */
	if (restflag)
		return(resterr());
#endif

	movecursor(term.t_nrow, 0);		/* Seek to last line.	*/
	TTflush();

	vttidy();
	(void)kill(0, SIGTSTP); /* suspend all processes within a group */
	TTkopen();
}

/* ARGSUSED */
SIGRET_T
rtfrmshell(int SIGARG_T(dummy))
{
	ttopen();
	curwp->w_flag = WFHARD;
	sgarbf = TRUE;
	(void)signal(SIGCONT, rtfrmshell);
}
#endif

/*
 * Run a one-liner in a subjob. When the command returns, wait for a single
 * character to be typed, then mark the screen as garbage so a full repaint is
 * done. Bound to "C-X !".
 */
/*ARGSUSED*/
int spawn(int f, int n)
{
	int	s;
	Char		line[NLINE];

#if	RESTRICT
	/* don't allow this command if restricted */
	if (restflag)
		return(resterr());
#endif

	if ((s=mlreply(CSTR("!"),
				  line, NLINE)) != TRUE)
		return (s);
	TTputc('\n');                /* Already have '\r'    */
	TTflush();
	(void)System(cfromC(line), TRUE, NULL, NULL);
	mlputs(
#if KMSGS
	    kterminal? CSTR("[終了]"):
#endif
	    CSTR("[End]"));
	TTflush();
	/* Pause. */
	while ((s = tgetc()) != '\r' && s != '\n' && s != ' ')
		;
	sgarbf = TRUE;
	return (TRUE);
}

/*
 * ================================================================
 * Async preview support
 * ================================================================
 *
 * spawn_preview() runs $md-preview-command in the background with its
 * stdout/stderr connected to a pipe.  preview_poll() (called once per
 * iteration of the main command loop) appends whatever the command
 * wrote to a dedicated buffer, so the output never touches the
 * terminal nor the buffer that was current when the preview started.
 *
 * The child calls setsid(), so it leads its own process group and
 * killing -pv_pid terminates the whole group (e.g. grip and any
 * helpers it spawned) without signalling kemacs itself.
 */

#define PREV_PIPE_BUFSIZ	1024	/* pipe read chunk		*/
#define PREV_LINE_BUFSIZ	NLINE	/* output line accumulator	*/

typedef struct {
	pid_t	pv_pid;			/* child process id (0: none)	*/
	int	pv_fd;			/* read end of the pipe (-1: none) */
	int	pv_active;		/* TRUE while the child runs	*/
	int	pv_dirty;		/* new output waiting for a redraw */
	int	pv_something;		/* some output arrived at least once */
	BUFFER	*pv_bp;			/* output buffer		*/
	BUFFER	*pv_prev;		/* buffer to restore when closing */
	Char	pv_tmp[NLINE];		/* temporary file to remove on close */
} PREVIEW;

static PREVIEW prev;

static Char	prev_line[PREV_LINE_BUFSIZ];	/* partial output line	*/
static int	prev_line_len = 0;
static int	prev_line_started = 0;	/* a line is open (even if empty) */

/*
 * preview_flush_line() -- append the accumulated partial line to the
 * preview buffer as one complete line.
 */
static void
preview_flush_line(void)
{
	if (prev.pv_bp == NULL || (prev_line_len == 0 && !prev_line_started))
		return;
	prev_line[prev_line_len] = 0;
	if (addline(prev.pv_bp, prev_line) == TRUE) {
		prev.pv_something = TRUE;
		prev.pv_dirty = TRUE;
	}
	prev_line_len = 0;
	prev_line_started = 0;
}

/*
 * preview_ingest() -- split raw command output into lines and append
 * them to the preview buffer.  A trailing partial line is kept until
 * the next chunk or until the process ends.
 */
static void
preview_ingest(char *data, int len)
{
	int i;

	for (i = 0; i < len; i++) {
		unsigned char c = (unsigned char)data[i];

		if (c == '\r')			/* strip CR from CRLF	*/
			continue;
		if (c == '\n') {
			prev_line_started = 1;
			preview_flush_line();
			continue;
		}
		if (prev_line_len >= PREV_LINE_BUFSIZ - 1) {
			/* very long line: wrap instead of overflowing */
			prev_line_started = 1;
			preview_flush_line();
		}
		prev_line[prev_line_len++] = (Char)c;
		prev_line_started = 1;
	}
}

/*
 * preview_mark_dirty() -- flag every window showing the preview buffer
 * for a redraw, and keep the cursor at the end so new output is visible.
 */
static void
preview_mark_dirty(void)
{
	WINDOW *wp;

	if (prev.pv_bp == NULL)
		return;
	wp = wheadp;
	while (wp != NULL) {
		if (wp->w_bufp == prev.pv_bp) {
			wp->w_flag |= WFHARD;
			if (wp == curwp && curbp == prev.pv_bp) {
				wp->w_dotp = prev.pv_bp->b_linep;
				wp->w_doto = 0;
			}
		}
		wp = wp->w_wndp;
	}
}

/*
 * preview_reap() -- collect the child if it exited and drain any output
 * still sitting in the pipe.
 */
static void
preview_reap(void)
{
	char	buf[PREV_PIPE_BUFSIZ];
	int	n;
	int	st;

	if (!prev.pv_active || prev.pv_pid <= 0)
		return;
	if (waitpid(prev.pv_pid, &st, WNOHANG) != prev.pv_pid)
		return;
	prev.pv_active = FALSE;
	if (prev.pv_fd >= 0) {
		while ((n = read(prev.pv_fd, buf, sizeof(buf))) > 0)
			preview_ingest(buf, n);
		(void)close(prev.pv_fd);
		prev.pv_fd = -1;
	}
	preview_flush_line();
	if (prev.pv_bp != NULL) {
		(void)addline(prev.pv_bp, CSTR("[preview finished]"));
		prev.pv_something = TRUE;
		prev.pv_dirty = TRUE;
	}
}

/*
 * preview_kill_process() -- terminate the preview process (whole process
 * group) and close the pipe.
 */
static void
preview_kill_process(void)
{
	int	st;
	int	i;

	if (prev.pv_pid <= 0)
		return;
	(void)kill(-prev.pv_pid, SIGTERM);
	(void)kill(prev.pv_pid, SIGTERM);
	for (i = 0; i < 50; i++) {
		if (waitpid(prev.pv_pid, &st, WNOHANG) == prev.pv_pid)
			break;
		millisleep(TRUE, 10);
	}
	if (i >= 50) {
		(void)kill(-prev.pv_pid, SIGKILL);
		(void)kill(prev.pv_pid, SIGKILL);
		(void)waitpid(prev.pv_pid, &st, 0);
	}
	prev.pv_pid = 0;
	prev.pv_active = FALSE;
	if (prev.pv_fd >= 0) {
		(void)close(prev.pv_fd);
		prev.pv_fd = -1;
	}
}

/*
 * preview_detach() -- detach the preview buffer from every window and
 * attach repl instead.  Mirrors the bookkeeping done by swbuffer() and
 * delwind().
 */
static void
preview_detach(BUFFER *bp, BUFFER *repl)
{
	WINDOW *wp;

	if (bp == NULL || repl == NULL)
		return;
	wp = wheadp;
	while (wp != NULL) {
		if (wp->w_bufp == bp) {
			if (--bp->b_nwnd == 0) {
				bp->b_dotp  = wp->w_dotp;
				bp->b_doto  = wp->w_doto;
				bp->b_markp = wp->w_markp;
				bp->b_marko = wp->w_marko;
			}
			wp->w_bufp = repl;
			if (repl->b_nwnd++ == 0) {
				wp->w_dotp  = repl->b_dotp;
				wp->w_doto  = repl->b_doto;
				wp->w_markp = repl->b_markp;
				wp->w_marko = repl->b_marko;
			}
			wp->w_linep = repl->b_linep;
			wp->w_flag |= WFMODE|WFFORCE|WFHARD;
		}
		wp = wp->w_wndp;
	}
}

/*
 * preview_poll() -- read whatever the preview command has written so far.
 * Called once per iteration of the main command loop.
 */
void
preview_poll(void)
{
	char	buf[PREV_PIPE_BUFSIZ];
	int	n;

	if (prev.pv_bp == NULL && !prev.pv_active)
		return;
	if (prev.pv_fd >= 0) {
		while ((n = read(prev.pv_fd, buf, sizeof(buf))) > 0)
			preview_ingest(buf, n);
		if (n == 0) {			/* EOF: child closed stdout */
			(void)close(prev.pv_fd);
			prev.pv_fd = -1;
		}
	}
	preview_reap();
	if (prev.pv_dirty) {
		preview_mark_dirty();
		prev.pv_dirty = FALSE;
	}
}

/*
 * preview_wait_first() -- give a freshly started preview command a moment
 * to produce its first output (grip prints its banner immediately), so
 * the buffer is not empty when M-Y returns.  Bounded at ~300 ms.
 */
void
preview_wait_first(void)
{
	int	i;

	for (i = 0; i < 15; i++) {
		preview_poll();
		if (prev.pv_something || !prev.pv_active)
			break;
		millisleep(TRUE, 20);
	}
}

/*
 * preview_close() -- kill the preview process, drop its buffer and
 * restore the buffer that was current before the preview started.
 */
void
preview_close(void)
{
	BUFFER	*bp;
	BUFFER	*repl;
	int	curwasprev;

	if (prev.pv_bp == NULL && !prev.pv_active) {
		prev_line_len = 0;
		prev_line_started = 0;
		return;
	}
	preview_kill_process();
	bp = prev.pv_bp;
	repl = prev.pv_prev;
	curwasprev = (bp != NULL && curbp == bp);
	preview_flush_line();		/* keep a trailing partial line	*/
	prev.pv_bp = NULL;
	prev.pv_prev = NULL;
	prev_line_len = 0;
	prev_line_started = 0;
	if (bp != NULL) {
		if (curwasprev && repl != NULL && repl != bp)
			(void)swbuffer(repl);
		preview_detach(bp, repl);
		(void)bclear(bp);
		(void)zotbuf(bp);
	}
	if (prev.pv_tmp[0] != 0) {
		(void)unlink(cfromC(prev.pv_tmp));
		prev.pv_tmp[0] = 0;
	}
}

/*
 * preview_abort() -- ^C in the preview buffer kills the preview process
 * and closes only that buffer.  Returns FALSE when the current buffer is
 * not the preview buffer, leaving the normal ^C behaviour untouched.
 */
int
preview_abort(void)
{
	if (prev.pv_bp == NULL || curbp != prev.pv_bp)
		return FALSE;
	preview_close();
	return TRUE;
}

/*
 * spawn_preview() -- run cmd asynchronously, capturing its output into a
 * buffer called bname.  tmpfile (may be empty) is removed when the
 * preview is closed.  Returns TRUE on success.
 */
int
spawn_preview(Char *cmd, Char *bname, Char *tmpfile)
{
	int	fds[2];
	pid_t	pid;
	int	i;

	if (cmd == NULL || cmd[0] == 0 || bname == NULL)
		return FALSE;
	preview_close();			/* stop any previous preview */

	if (pipe(fds) < 0)
		return FALSE;
	if ((pid = fork()) < 0) {
		(void)close(fds[0]);
		(void)close(fds[1]);
		return FALSE;
	}
	if (pid == 0) {
		int devnull;

		(void)setsid();			/* own process group	*/
		if ((devnull = open("/dev/null", O_RDONLY)) >= 0) {
			(void)dup2(devnull, 0);
			if (devnull > 2)
				(void)close(devnull);
		}
		(void)dup2(fds[1], 1);
		(void)dup2(fds[1], 2);
		(void)close(fds[0]);
		(void)close(fds[1]);
		(void)execlp("/bin/sh", "sh", "-c", cfromC(cmd), (char *)NULL);
		_exit(127);
	}
	(void)close(fds[1]);
	(void)fcntl(fds[0], F_SETFL, O_NONBLOCK);

	prev.pv_pid = pid;
	prev.pv_fd = fds[0];
	prev.pv_active = TRUE;
	prev.pv_dirty = FALSE;
	prev.pv_something = FALSE;
	prev_line_len = 0;
	prev_line_started = 0;
	prev.pv_tmp[0] = 0;
	if (tmpfile != NULL) {
		for (i = 0; tmpfile[i] && i < NLINE - 1; i++)
			prev.pv_tmp[i] = tmpfile[i];
		prev.pv_tmp[i] = 0;
	}

	prev.pv_bp = bfind(bname, TRUE, BFINVS);
	if (prev.pv_bp == NULL) {
		(void)close(fds[0]);
		prev.pv_fd = -1;
		prev.pv_pid = 0;
		prev.pv_active = FALSE;
		return FALSE;
	}
	prev.pv_bp->b_mode |= MDVIEW;
	prev.pv_prev = curbp;
	(void)bclear(prev.pv_bp);
	(void)swbuffer(prev.pv_bp);
	return TRUE;
}

/*
 * Pipe a one line command into a window
 * Bound to ^X @
 */
/*ARGSUSED*/
int pipecmd(int f, int n)
{
	int	s;	/* return status from CLI */
	WINDOW *wp;	/* pointer to new window */
	BUFFER *bp;	/* pointer to buffer to zot */
	Char	line[NLINE];	/* command line send to shell */
	static Char *bname = CSTR("[command]");
	bool	retval;

	static char tmpdirtmpl[] = "/tmp/.kmXXXXXX";
	static char tmpfilbas[] = ",command";
	char tmpdirname[sizeof(tmpdirtmpl)];
	char tmpfilnam[sizeof(tmpdirtmpl) + sizeof(tmpfilbas)];
	Char *filnam;

#if	RESTRICT
	/* don't allow this command if restricted */
	if (restflag)
		return(resterr());
#endif

	/* get the command to pipe in */
	if ((s=mlreply(CSTR("@"), line, NLINE)) != TRUE)
		return(s);

	/* get rid of the command output buffer if it exists */
	if ((bp=bfind(bname, FALSE, 0)) != FALSE) {
		/* try to make sure we are off screen */
		wp = wheadp;
		while (wp != NULL) {
			if (wp->w_bufp == bp) {
				(void)onlywind(FALSE, 1);
				break;
			}
			wp = wp->w_wndp;
		}
		if (zotbuf(bp) != TRUE)
			return(FALSE);
	}

	/* make temporal dir */
	snprintf(tmpdirname, sizeof(tmpdirname), "%s", tmpdirtmpl);
	if(mkdtemp(tmpdirname) == NULL) return(FALSE);
	chmod(tmpdirname, 0700); /* in case umask is like 0266... :-) */
	snprintf(tmpfilnam, sizeof(tmpfilnam), "%s/%s", tmpdirname, tmpfilbas);
	filnam = SafeCfromc(tmpfilnam);

	TTflush();
	(void)System(cfromC(line), TRUE, NULL, tmpfilnam);
	TTflush();
	sgarbf = TRUE;

	/* s = TRUE;
	   if (s != TRUE)
		return(s); */

	/* split the current window to make room for the command output */
	if (splitwind(FALSE, 1) == FALSE){
		retval = FALSE;
		goto return_gracefully;
	}

	/* and read the stuff in */
	if (getfile(filnam, FALSE) == FALSE){
		retval = FALSE;
		goto return_gracefully; 
	}

	/* set name and make this window in VIEW mode, update all mode lines */
	(void)copystr(&curwp->w_bufp->b_bname, bname);
	(void)copystr(&curwp->w_bufp->b_fname, CSTR(""));
	curwp->w_bufp->b_mode |= MDVIEW;
	upmode();
	retval = TRUE;

	/* and get rid of the temporary file */
    return_gracefully:
	Free(filnam);
	(void)unlink(tmpfilnam);
	rmdir(tmpdirname);
	return(retval);
}

/*
 * filter a buffer through an external DOS program
 * Bound to ^X #
 */
/*ARGSUSED*/
int filter(int f, int n)
{
	int	s;	/* return status from CLI */
	BUFFER *bp;	/* pointer to buffer to zot */
	Char line[NLINE];	/* command line send to shell */
	Char *tmpnam;		/* place to store real file name */
	bool retval;

	static char tmpdirtmpl[] = "/tmp/.kmXXXXXX";
	static char tmpfilbas1[] = ",fltinp";
	static char tmpfilbas2[] = ",fltout";
	char tmpdirname[sizeof(tmpdirtmpl)];
	char tmpfilnam1[sizeof(tmpdirtmpl) + sizeof(tmpfilbas1)];
	char tmpfilnam2[sizeof(tmpdirtmpl) + sizeof(tmpfilbas2)];
	Char *filnam1, *filnam2;

#if	RESTRICT
	/* don't allow this command if restricted */
	if (restflag)
		return(resterr());
#endif

	if (curbp->b_mode & MDVIEW)	/* don't allow this command if	*/
		return(rdonly());	/* we are in read only mode	*/

	/* get the filter name and its args */
	if ((s=mlreply(CSTR("#"), line, NLINE)) != TRUE)
		return(s);

	/* make temporal dir */
	snprintf(tmpdirname, sizeof(tmpdirname), "%s", tmpdirtmpl);
	if(mkdtemp(tmpdirname) == NULL) return(FALSE);
	chmod(tmpdirname, 0700); /* in case umask is like 0266... :-) */
	snprintf(tmpfilnam1, sizeof(tmpfilnam1), "%s/%s", tmpdirname, tmpfilbas1);
	snprintf(tmpfilnam2, sizeof(tmpfilnam2), "%s/%s", tmpdirname, tmpfilbas2);
	filnam1 = SafeCfromc(tmpfilnam1);
	filnam2 = SafeCfromc(tmpfilnam2);

	/* setup the proper file names */
	bp = curbp;
	tmpnam = bp->b_fname;	/* save the original name */
	bp->b_fname = NULL;

	/* write it out, checking for errors */
	if (writeout(filnam1) != TRUE) {
		mlwrite(
#if KMSGS
		    kterminal? CSTR("[フィルタ用ファイルに書き込めません]"):
#endif
		    CSTR("[Cannot write filter file]"));
		retval = FALSE;
		goto return_gracefully;
	}

	TTflush();
	(void)System(cfromC(line), TRUE, tmpfilnam1, tmpfilnam2);
	TTflush();
	sgarbf = TRUE;

	/* on failure, escape gracefully */
	if (readin(filnam2, FALSE) != TRUE) {
		mlwrite(
#if KMSGS
		    kterminal? CSTR("[実行結果を読み込めません]"):
#endif
		    CSTR("[Can't read the result]"));
		retval = FALSE; /* not s, I think. Nide */ 
		goto return_gracefully;
	}

	retval = TRUE;
	bp->b_flag |= BFCHG;		/* flag it as changed */

  return_gracefully:
	/* reset file name */
	free((char *)bp->b_fname);
	bp->b_fname =  tmpnam;	/* restore name */

	/* and get rid of the temporary file */
	Free(filnam1);
	Free(filnam2);
	(void)unlink(tmpfilnam1);
	(void)unlink(tmpfilnam2);
	rmdir(tmpdirname);
	return(retval);
}

/*
 * Shell-escape a string for safe use as a single POSIX shell argument.
 * Wraps the string in single quotes, escaping embedded single quotes
 * with the '\'' sequence.  Returns a pointer to a static buffer,
 * or NULL if the result would overflow the buffer.
 */
char *
shell_command_escape_char(const char *s)
{
	const char *p;
	char *q;
	int qlen, slen;

	if (!s) s = "";
	slen = strlen(s);
	qlen = 0;
	for (p = s; *p; p++)
		if (*p == '\'') qlen++;

	if (slen + qlen * 3 + 3 > (int)sizeof(shell_esc_buf))
		return NULL;

	q = shell_esc_buf;
	*q++ = '\'';
	for (p = s; *p; p++) {
		if (*p == '\'') {
			*q++ = '\'';
			*q++ = '\\';
			*q++ = '\'';
			*q++ = '\'';
		} else {
			*q++ = *p;
		}
	}
	*q++ = '\'';
	*q = '\0';
	return shell_esc_buf;
}

/*
 * Editor command: prompt for a string and display its shell-escaped form.
 * Useful for verifying escaping before embedding a value in a macro.
 */
/*ARGSUSED*/
int
shell_escape_cmd(int f, int n)
{
	Char	line[NLINE];
	int	s;
	char	*cmd;
	char	*escaped;
	Char	result[NLINE * 5];

	if ((s=mlreply(CSTR("Shell-escape: "), line, NLINE)) != TRUE)
		return (s);

	cmd = cfromC(line);
	escaped = shell_command_escape_char(cmd);
	if (escaped) {
		(void)Cstrcpy(result, CSTR("Escaped: "));
		(void)Cstrcat(result, Cfromc(escaped));
		mlwrite(result);
	}
	return (TRUE);
}

/*
 * execute shell command.
 */
static int
System(char * cmd, bool via_shell_p, char * inf, char * outf)
{

    int s;

#if	RESTRICT
    /* don't allow shell execution if restricted */
    if (restflag)
	return(resterr());
#endif
#if	CLOCK
    SIGRET_T (*f)();
    unsigned t;
#endif

    /* shell escaping is done at the call site (e.g. via the
       &shell-command-escape macro function in .kemacsrc) so that
       individual filenames/arguments are quoted, not the whole cmd.
       $shell-command-mode is available for macros to test. */
#if	CLOCK
    f = signal(SIGALRM, SIG_IGN);
    t = alarm((unsigned)0);
#endif
    TTclose();

    switch(fork()){
    case -1:
	s = -1;
	break;
    case 0:
	if(inf != NULL){
	    if(freopen(inf, "r", stdin) == NULL) exit(-1);
	}
	if(outf != NULL){
	    if(freopen(outf, "w", stdout) == NULL) exit(-1);
	}
	
	if(via_shell_p){
	    execlp("/bin/sh", "/bin/sh", "-c", cmd, NULL);
	} else {
	    execlp(cmd, cmd, NULL);
	}
	exit(-1);
    default:
	for(;;){
	    int child_stat;

	    if(0 >= wait(&child_stat)){s = -1; break;}
	    switch(child_stat & 0xff){
	    case 0: /* exitted */
		s = (child_stat >> 8) & 0xff; break;
	    case 0x7f: /* stopped */
		continue;
	    default: /* terminated by signal */
		s = -1; break;
	    }
	    break;
	}
    }

    ttopen();
#if	CLOCK
    (void)signal(SIGALRM, f);
    (void)alarm(t);
#endif
    return s;
}
