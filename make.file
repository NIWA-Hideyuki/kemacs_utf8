## This file is made from mf.c
## Don't modify this directly!
## Instead, modify mf.c and type
##	make make.file

CC = cc
PREFIX = /usr/local
PROGRAM = kemacs
DEST = $(PREFIX)/bin
OWNER = root
GROUP = staff
MODE = 755
MNAME = kemacs.1
MDEST = $(PREFIX)/man/man1
LIBDEST = $(PREFIX)/lib/kemacs
RCFILE = .kemacsrc
OPTIM = -O2
DEBUG =# -g
DEFS =
GDEFS = -std=gnu89
STRIPFLG = -s
FCODE = -w
EINCL = # Some systems do not need above (Linux, Cygwin etc.) */
INCL = $(EINCL) -Ikanji -ICstrings
ELIBS = -lncurses # Linux */
ILIBS = # with glibc (Linux: iconv is built-in) */
MAKE_HERE = $(MAKE) -f make.file
MAKE_KANJI = $(MAKE) -f Makefile.kanji CC='$(CC)' CCFLAGS='$(CCFLAGS)' EINCL='$(EINCL)'
MAKE_KPP = $(MAKE) -f Makefile.kpp CC='$(CC)' CCFLAGS='$(CCFLAGS)' \
	    EINCL='$(EINCL)' ILIBS='$(ILIBS)'
MAKE_CSTR = $(MAKE) -f Makefile.Cstr CC='$(CC)' CCFLAGS='$(CCFLAGS)' EINCL='$(EINCL)'
KPP = kpp/kpp
FTOC = kpp/ftoc
INSTALL = install
MAKETD = maketd
LINT = lint
CTAGS = ctags
.SUFFIXES:
.SUFFIXES: .o .c .C_ .h .H_
CCFLAGS = $(OPTIM) $(GDEFS) $(DEBUG)
CFLAGS = $(CCFLAGS) $(INCL) $(DEFS)
LDFLAGS = $(DEBUG) $(DEFS)
LINTFLAGS = -xhb $(INCL)
INSTFLAGS_NONROOT = -c $(STRIPFLG) -m $(MODE)
INSTFLAGS = $(INSTFLAGS_NONROOT) -o $(OWNER) -g $(GROUP)
LIBS = kanji/kanji.a Cstrings/Cstrings.a
OBJS = basic.o \
	 bind.o \
	 buffer.o \
	 crypt.o \
	 display.o \
	 eval.o \
	 exec.o \
	 file.o \
	 fileio.o \
	 input.o \
	 isearch.o \
	 kanji.o \
	 line.o \
	 main.o \
	 random.o \
	 region.o \
	 search.o \
	 spawn.o \
	 tcap.o \
	 termio.o \
	 undo.o \
	 version.o \
	 window.o \
	 word.o \
	 python.o \
	 cmode.o
SRCS = basic.C_ \
	 bind.C_ \
	 buffer.C_ \
	 crypt.C_ \
	 display.C_ \
	 eval.C_ \
	 exec.C_ \
	 file.C_ \
	 fileio.C_ \
	 input.C_ \
	 isearch.C_ \
	 kanji.C_ \
	 line.C_ \
	 main.C_ \
	 random.C_ \
	 region.C_ \
	 search.C_ \
	 spawn.C_ \
	 tcap.C_ \
	 termio.C_ \
	 undo.C_ \
	 version.C_ \
	 window.C_ \
	 word.C_ \
	 python.C_ \
	 cmode.C_
CSRCS = basic.c \
	 bind.c \
	 buffer.c \
	 crypt.c \
	 display.c \
	 eval.c \
	 exec.c \
	 file.c \
	 fileio.c \
	 input.c \
	 isearch.c \
	 kanji.c \
	 line.c \
	 main.c \
	 random.c \
	 region.c \
	 search.c \
	 spawn.c \
	 tcap.c \
	 termio.c \
	 undo.c \
	 version.c \
	 window.c \
	 word.c \
	 python.c \
	 cmode.c
HDRS = ebind.H_ \
	 ecomm.H_ \
	 edef.H_ \
	 efunc.H_ \
	 epath.H_ \
	 estruct.H_ \
	 evar.H_ \
	 eversion.H_
HHDRS = ebind.h \
	 ecomm.h \
	 edef.h \
	 efunc.h \
	 epath.h \
	 estruct.h \
	 evar.h \
	 eversion.h
MANUAL = kemacs.man
DOCS = Cmds.narrow Commands.me Macros Readme Tech WhatsNew \
	 emacs.key emacs.hlp emacs.HLP_ emacs.tut emacs.TUT_ \
	 emacs.mss magic.doc Added Install Manifest .kemacsrc ccg
STROBJ = Css.o
all: $(KPP) $(FTOC) $(PROGRAM) $(RCFILE)
debug:; @ $(MAKE_HERE) all PROGRAM="a.out"
	  OPTIM=""
	  DEBUG="-g"
$(PROGRAM): $(OBJS) $(LIBS) $(STROBJ)
	      @ echo "Loading $(PROGRAM) ..."
	      $(CC) $(LDFLAGS) $(STROBJ) $(OBJS) $(LIBS) $(ELIBS) $(ILIBS) -o $(PROGRAM)
	      @ echo "done"
clean:
	      @ echo "Cleaning up directory ..."
	      @ cd kpp; $(MAKE_KPP) clean
	      @ cd kanji; $(MAKE_KANJI) clean
	      @ cd Cstrings; $(MAKE_CSTR) clean
	      @ rm -f $(PROGRAM) $(OBJS) $(CSRCS) $(HHDRS) Cxx.* Css.* a.out Cstr.data make.file *.bak core $(RCFILE)
realclean:
	      @ echo "Cleaning all binaries and executables ..."
	      @ cd kpp; $(MAKE_KPP) realclean
	      @ cd kanji; $(MAKE_KANJI) realclean
	      @ cd Cstrings; $(MAKE_CSTR) realclean
	      @ rm -f $(PROGRAM) $(OBJS) $(CSRCS) $(HHDRS) Cxx.* Css.* a.out Cstr.data make.file *.bak core $(RCFILE)
install: inst-bin inst-man inst-lib
inst-bin: $(PROGRAM)
	      @ echo Installing $(PROGRAM) in $(DEST) "..."
	      -mkdir $(DEST) || mkdir -p $(DEST)
	      case "`id`" in \
	      uid=0*|'') $(INSTALL) $(INSTFLAGS) $(PROGRAM) $(DEST);; \
	      *) $(INSTALL) $(INSTFLAGS_NONROOT) $(PROGRAM) $(DEST);; \
	      esac
	      @ echo " done"
inst-man:
	      @ echo -n "Installing manual ..."
	      -mkdir $(MDEST) || mkdir -p $(MDEST)
	      if [ `pwd`/$(MANUAL) != $(MDEST)/$(MNAME) ]; then \
	  cp $(MANUAL) $(MDEST)/$(MNAME); \
	 fi
	      @ echo " done"
inst-lib: $(RCFILE)
	      @ echo -n "Installing library ..."
	      -mkdir $(LIBDEST) || mkdir -p $(LIBDEST)
	      if [ `pwd` != $(LIBDEST) ]; then \
	  cp $(DOCS) $(LIBDEST); \
	  chmod a+x $(LIBDEST)/ccg; \
	 fi
	      @ echo " done"
update: $(DEST)/$(PROGRAM)
$(DEST)/$(PROGRAM): $(PROGRAM)
	      $(MAKE_HERE) install
lint: $(CSRCS) $(HHDRS)
	      @ "$(LINT)" $(LINTFLAGS) $(CSRCS) 2>&1 | egrep -v 'possible pointer alignment'
test: $(STROBJ) $(LIBS) $(PROGRAM)
	      @ echo "Running kemacs test suite ..."
	      @ cd tests; $(MAKE) run
tags: $(HHDRS) $(CSRCS)
	      @ echo Making tags ...
	      @ $(CTAGS) -t $(HHDRS) $(CSRCS)
	      @ sed -e 's/\.c	/.C_	/' -e 's/\.h	/.H_	/' tags >tags.tmp
	      @ mv tags.tmp tags
depend: $(HHDRS) $(CSRCS)
	      @ echo Remaking dependencies...
	      @ $(MAKETD) -mmf.dep $(INCL) $(DEFS) $(CSRCS)
FORCE:
kanji/kanji.a: FORCE
	      cd kanji; $(MAKE_KANJI) all
Cstrings/Cstrings.a: FORCE
	      cd Cstrings; $(MAKE_CSTR) all
Css.o: Css.c
	 $(CC) -c $(SHARESTR) $*.c
.C_.c:; @ echo processing $*.C_ ...
	      $(KPP) $(FCODE) $*.C_
	      mv Cxx.c $@
.c.o:; $(CC) $(CFLAGS) -c $*.c
epath.h: epath.H_
	      sed -e 's|_PREFIX_|$(PREFIX)|g' $*.H_ | $(KPP) $(FCODE)
	      mv Cxx.c $@
.H_.h:; @ echo processing $*.H_ ...
	      $(KPP) $(FCODE) $*.H_
	      mv Cxx.c $@
Css.c: Cstr.data
	      @ echo Making $@ ...
	      @ $(FTOC)
$(KPP) $(FTOC): $(LIBS) FORCE
	      cd kpp; $(MAKE_KPP) all
co: $(HDRS) $(SRCS) $(MANUAL) $(DOCS)
.DEFAULT:; co -l $@
$(HHDRS) $(CSRCS): $(KPP)
$(OBJS): $(HHDRS)
ebind.h: ebind.H_
ecomm.h: ecomm.H_
edef.h: edef.H_
efunc.h: efunc.H_
epath.h: epath.H_
estruct.h: estruct.H_
evar.h: evar.H_
eversion.h: eversion.H_
basic.c: basic.C_
bind.c: bind.C_
buffer.c: buffer.C_
crypt.c: crypt.C_
display.c: display.C_
eval.c: eval.C_
exec.c: exec.C_
file.c: file.C_
fileio.c: fileio.C_
input.c: input.C_
isearch.c: isearch.C_
kanji.c: kanji.C_
line.c: line.C_
main.c: main.C_
random.c: random.C_
region.c: region.C_
search.c: search.C_
spawn.c: spawn.C_
tcap.c: tcap.C_
termio.c: termio.C_
undo.c: undo.C_
version.c: version.C_
window.c: window.C_
word.c: word.C_
python.c: python.C_
cmode.c: cmode.C_
$(RCFILE): $(RCFILE).tmpl
	 sed -e 's|_PREFIX_|$(PREFIX)|g' $(RCFILE).tmpl > $@
# mf.dep
# DO NOT DELETE THIS LINE - make depend DEPENDS ON IT
A=Cstrings
B=kanji

basic.o: $A/Cstrings.h basic.c ecomm.h econfig.h edef.h estruct.h $B/kanji.h

bind.o: $A/Cstrings.h bind.c ecomm.h econfig.h edef.h epath.h estruct.h \
	$B/kanji.h

buffer.o: $A/Cstrings.h buffer.c ecomm.h econfig.h edef.h estruct.h \
	$B/kanji.h

crypt.o: $A/Cstrings.h crypt.c ecomm.h econfig.h edef.h estruct.h $B/kanji.h

display.o: $A/Cstrings.h display.c ecomm.h econfig.h edef.h estruct.h \
	$B/kanji.h

eval.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h eval.c evar.h \
	$B/kanji.h

exec.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h exec.c $B/kanji.h

file.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h file.c $B/kanji.h

fileio.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h fileio.c \
	$B/kanji.h

input.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h input.c $B/kanji.h

isearch.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h isearch.c \
	$B/kanji.h

kanji.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h $B.c $B/kanji.h

line.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h $B/kanji.h line.c

main.o: $A/Cstrings.h ebind.h ecomm.h econfig.h edef.h efunc.h estruct.h \
	$B/kanji.h main.c

random.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h $B/kanji.h \
	random.c

region.o: $A/Cstrings.h ecomm.h econfig.h edef.h estruct.h $B/kanji.h \
